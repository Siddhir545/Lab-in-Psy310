      <Param name="conditions" updates="None" val="[{'imgfile': 'images/black1.jpg', 'old_new': 'old', 'CorrectAns': 'y', 'img_brightness': 'bright'}, {'imgfile': 'images/black2.jpg', 'old_new': 'old', 'CorrectAns': 'y', 'img_brightness': 'dark'}, {'imgfile': 'images/black3.jpg', 'old_new': 'old', 'CorrectAns': 'y', 'img_brightness': 'bright'}, {'imgfile': 'images/darkblue1.jpg', 'old_new': 'old', 'CorrectAns': 'y', 'img_brightness': 'dark'}, {'imgfile': 'images/green1.jpg', 'old_new': 'old', 'CorrectAns': 'y', 'img_brightness': 'bright'}, {'imgfile': 'images/green2.jpg', 'old_new': 'old', 'CorrectAns': 'y', 'img_brightness': 'dark'}, {'imgfile': 'images/red1.jpeg', 'old_new': 'old', 'CorrectAns': 'y', 'img_brightness': 'dark'}, {'imgfile': 'images/red2.jpg', 'old_new': 'old', 'CorrectAns': 'y', 'img_brightness': 'bright'}, {'imgfile': 'images/shallowblue1.jpg', 'old_new': 'old', 'CorrectAns': 'y', 'img_brightness': 'dark'}, {'imgfile': 'images/white1.jpg', 'old_new': 'old', 'CorrectAns': 'y', 'img_brightness': 'bright'}, {'imgfile': 'images/white2.jpeg', 'old_new': 'old', 'CorrectAns': 'y', 'img_brightness': 'dark'}, {'imgfile': 'images/yellow1.jpg', 'old_new': 'old', 'CorrectAns': 'y', 'img_brightness': 'bright'}, {'imgfile': 'images/foil_black1.jpg', 'old_new': 'new', 'CorrectAns': 'n', 'img_brightness': 'bright'}, {'imgfile': 'images/foil_black2.jpg', 'old_new': 'new', 'CorrectAns': 'n', 'img_brightness': 'dark'}, {'imgfile': 'images/foil_black3.jpg', 'old_new': 'new', 'CorrectAns': 'n', 'img_brightness': 'bright'}, {'imgfile': 'images/foil_darkblue1.jpg', 'old_new': 'new', 'CorrectAns': 'n', 'img_brightness': 'dark'}, {'imgfile': 'images/foil_green1.jpg', 'old_new': 'new', 'CorrectAns': 'n', 'img_brightness': 'bright'}, {'imgfile': 'images/foil_green2.jpg', 'old_new': 'new', 'CorrectAns': 'n', 'img_brightness': 'dark'}, {'imgfile': 'images/foil_red1.jpeg', 'old_new': 'new', 'CorrectAns': 'n', 'img_brightness': 'dark'}, {'imgfile': 'images/foil_red2.jpg', 'old_new': 'new', 'CorrectAns': 'n', 'img_brightness': 'bright'}, {'imgfile': 'images/foil_shallowblue1.jpeg', 'old_new': 'new', 'CorrectAns': 'n', 'img_brightness': 'dark'}, {'imgfile': 'images/foil_white1.jpg', 'old_new': 'new', 'CorrectAns': 'n', 'img_brightness': 'bright'}, {'imgfile': 'images/foil_white2.jpeg', 'old_new': 'new', 'CorrectAns': 'n', 'img_brightness': 'dark'}, {'imgfile': 'images/foil_yellow1.jpg', 'old_new': 'new', 'CorrectAns': 'n', 'img_brightness': 'bright'}]" valType="str"/>
